Output demo/demo.gif

Set FontSize 20
Set Width 1200
Set Height 700
Set PlaybackSpeed 1.0
Set TypingSpeed 0.05s
Set CursorBlink false
Set Theme "Dracula"

# Launch pomo-time — home screen with streak
Type "pomo"
Enter
Sleep 2s

# Show the menu: navigate down to "From template"
Type "j"
Sleep 0.5s
Type "j"
Sleep 1s

# Back to Quick session, name it
Type "k"
Sleep 0.5s
Type "k"
Sleep 0.5s

# Name the session before starting
Type "n"
Sleep 0.5s
Type "Deep Work"
Enter
Sleep 1s

# Start quick session (Focus, 1 min for demo)
Enter
Sleep 0.5s
Type "1"
Enter
Sleep 2s

# Open notes overlay mid-session
Type "m"
Sleep 0.5s
Type "working on goreleaser setup"
Escape
Sleep 2s

# Toggle compact mode
Type "z"
Sleep 2s
Type "z"
Sleep 1s

# Finish early
Type "f"
Sleep 2s

# Done screen — navigate to "New session"
Sleep 1s
Enter
Sleep 2s

# Back on home — navigate to Report
Type "r"
Sleep 3s

# Cycle to weekly view
Tab
Sleep 2s

# Close report
Type "r"
Sleep 1s

# Navigate to From template
Type "j"
Sleep 0.5s
Type "j"
Enter
Sleep 2s

# Select Pomodoro template
Enter
Sleep 2s

# Start first interval
Enter
Sleep 3s

# Background the timer
Backspace
Sleep 2s

# Home screen shows live background countdown
Sleep 3s

# Resume
Enter
Sleep 2s

# Quit cleanly
Type "q"
Sleep 1s
